<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:NubeZero.Shared;assembly=NubeZero.Shared"
        x:Class="NubeZero.Desktop.MainWindow"
        Icon="/Assets/icon.ico"
        Title="NubeZero" Width="1050" Height="700"
        MinWidth="800" MinHeight="550"
        WindowState="Maximized"
        Background="#121212"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        ExtendClientAreaToDecorationsHint="True"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Button.Fab">
            <Setter Property="Background" Value="#00D2FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Fab:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1)"/>
            <Setter Property="Background" Value="#3A7BD5"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- FONDO PRINCIPAL CON GRADIENTE SLEEK -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#1E1E2C"/>
                    <GradientStop Offset="1" Color="#121212"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- VISTA PRINCIPAL (Sólo visible si IsLoggedIn = True) -->
        <Grid Name="MainView" IsVisible="False" RowDefinitions="Auto, *, Auto">
            
            <!-- HEADER RESPONSIVO -->
            <Border Grid.Row="0" Margin="20,40,20,10" Background="#20FFFFFF" CornerRadius="12" Padding="14,10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="☁️ Nube-Zero" FontSize="22" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                            
                            <!-- SELECTOR DE PESTAÑAS (ARCHIVOS / NOTAS) -->
                            <Border Background="#18FFFFFF" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Button Name="BtnTabFiles" Content="📁 Archivos" Click="BtnTabFiles_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="12,6"/>
                                    <Button Name="BtnTabNotes" Content="💬 Notas" Click="BtnTabNotes_Click" Background="Transparent" Foreground="#A0A0A0" FontWeight="SemiBold" CornerRadius="6" Padding="12,6"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1500D2FF" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Name="TxtUserInfo" Text="" Foreground="#00D2FF" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Name="TxtStatus" Text="Conectado" VerticalAlignment="Center" Foreground="#888888" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button Name="BtnCheckUpdatesMain" Content="⬇ Actualizar" Click="BtnCheckUpdates_Click" Background="#25FFFFFF" Foreground="White" CornerRadius="8" Padding="10,6" FontSize="12"/>
                            <Button Content="🔄 Recargar" Click="BtnRefresh_Click" Background="#25FFFFFF" Foreground="White" CornerRadius="8" Padding="10,6" FontSize="12"/>
                            <Button Name="BtnUsersAdmin" Content="👥 Usuarios" Click="BtnUsersAdmin_Click" Background="#25FFFFFF" Foreground="White" CornerRadius="8" IsVisible="False" Padding="10,6" FontSize="12"/>
                            <Button Content="🔑 Contraseña" Click="BtnOpenChangePassword_Click" Background="#25FFFFFF" Foreground="White" CornerRadius="8" Padding="10,6" FontSize="12"/>
                            <Button Content="Salir" Click="BtnLogout_Click" Background="#FF5555" Foreground="White" CornerRadius="8" Padding="12,6" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ZONA DRAG & DROP Y LISTADO DE ARCHIVOS -->
            <Border Name="FilesContainer" Grid.Row="1" Margin="20,10" Background="#10FFFFFF" CornerRadius="12" BorderBrush="#20FFFFFF" BorderThickness="1" IsVisible="True">
                <Grid RowDefinitions="Auto, Auto, *">
                    <!-- BARRA SUPERIOR DE ACCIONES Y NAVEGACIÓN -->
                    <Grid Grid.Row="0" Margin="14,10" ColumnDefinitions="Auto, *, Auto, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Name="BtnParentFolder" Content="↑" ToolTip.Tip="Carpeta anterior" Click="BtnParentFolder_Click" IsVisible="False" Background="#25FFFFFF" Foreground="White" CornerRadius="6" Padding="10,6"/>
                            <TextBlock Name="TxtCurrentPath" Text="/" VerticalAlignment="Center" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="14"/>
                        </StackPanel>

                        <!-- BUSCADOR RÁPIDO DE ARCHIVOS -->
                        <Border Grid.Column="1" Margin="20,0" Background="#18FFFFFF" CornerRadius="8" Padding="2" HorizontalAlignment="Stretch" MaxWidth="380">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#80FFFFFF" FontSize="13"/>
                                <TextBox Grid.Column="1" Name="TxtSearchFiles" PlaceholderText="Buscar archivo o carpeta..." Background="Transparent" BorderThickness="0" Foreground="White" Padding="6,6" TextChanged="TxtSearchFiles_TextChanged"/>
                                <Button Grid.Column="2" Name="BtnClearSearch" Content="✕" Click="BtnClearSearch_Click" Background="Transparent" Foreground="#A0A0A0" Padding="8,4" CornerRadius="6" IsVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- CONTROLES DE VISTA Y ORDENACIÓN -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,10,0" VerticalAlignment="Center">
                            <ComboBox Name="CmbSortFiles" SelectionChanged="CmbSortFiles_SelectionChanged" SelectedIndex="0" Background="#20FFFFFF" Foreground="White" CornerRadius="6" Padding="8,5" ToolTip.Tip="Ordenar archivos">
                                <ComboBoxItem Content="🔤 Nombre"/>
                                <ComboBoxItem Content="📅 Recientes"/>
                                <ComboBoxItem Content="⚖️ Tamaño"/>
                            </ComboBox>
                            <Button Name="BtnToggleViewMode" Content="⊞ Cuadrícula" Click="BtnToggleViewMode_Click" Background="#25FFFFFF" Foreground="White" CornerRadius="6" Padding="10,6" ToolTip.Tip="Cambiar entre lista y cuadrícula"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Name="BtnNewFolder" Content="📁+ Carpeta" Click="BtnNewFolder_Click" Background="#25FFFFFF" Foreground="White" FontWeight="SemiBold" CornerRadius="8" Padding="12,6"/>
                            <Button Name="BtnUploadTop" Content="⬆ Subir" Click="BtnUploadManual_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="14,6"/>
                        </StackPanel>
                    </Grid>

                    <!-- CHIPS DE FILTRO POR CATEGORÍA -->
                    <Border Grid.Row="1" Margin="14,0,14,10" Background="Transparent">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Name="BtnCatAll" Content="✨ Todos" Click="BtnFilterCategory_Click" Tag="Todos" Background="#00D2FF" Foreground="White" CornerRadius="12" Padding="12,4" FontWeight="Bold" FontSize="12"/>
                                <Button Name="BtnCatImages" Content="🖼️ Imágenes" Click="BtnFilterCategory_Click" Tag="Imágenes" Background="#18FFFFFF" Foreground="#CCCCCC" CornerRadius="12" Padding="12,4" FontSize="12"/>
                                <Button Name="BtnCatVideos" Content="🎬 Videos" Click="BtnFilterCategory_Click" Tag="Videos" Background="#18FFFFFF" Foreground="#CCCCCC" CornerRadius="12" Padding="12,4" FontSize="12"/>
                                <Button Name="BtnCatDocs" Content="📃 Documentos" Click="BtnFilterCategory_Click" Tag="Documentos" Background="#18FFFFFF" Foreground="#CCCCCC" CornerRadius="12" Padding="12,4" FontSize="12"/>
                                <Button Name="BtnCatApks" Content="📱 APKs" Click="BtnFilterCategory_Click" Tag="APKs" Background="#18FFFFFF" Foreground="#CCCCCC" CornerRadius="12" Padding="12,4" FontSize="12"/>
                                <Button Name="BtnCatZips" Content="🗜️ Comprimidos" Click="BtnFilterCategory_Click" Tag="Comprimidos" Background="#18FFFFFF" Foreground="#CCCCCC" CornerRadius="12" Padding="12,4" FontSize="12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- CONTENEDOR DE ELEMENTOS (LISTA Y GRID) -->
                    <Grid Grid.Row="2">
                        <TextBlock Name="TxtDragHint" Text="Arrastra tus archivos aquí o crea carpetas" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="#40FFFFFF" FontWeight="Bold" IsVisible="True"/>
                        
                        <!-- MODO LISTA -->
                        <ListBox Name="LstFiles" Background="Transparent" BorderThickness="0" Margin="5" DoubleTapped="LstFiles_DoubleTapped" IsVisible="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="shared:ArchivoDTO">
                                    <Grid ColumnDefinitions="48, *, Auto" Margin="5" AttachedToVisualTree="FileRow_AttachedToVisualTree">
                                        <Image Grid.Column="0" Source="{Binding ThumbnailSource}" Width="42" Height="42" Stretch="UniformToFill" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="0" Text="{Binding Icono}" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="16" Foreground="White"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding PesoBytes, Converter={StaticResource BytesToSizeConverter}}" FontSize="12" Foreground="#A0A0A0"/>
                                                <TextBlock Text="•" Foreground="#606060"/>
                                                <TextBlock Text="{Binding FechaModificacion, StringFormat='dd/MM/yyyy HH:mm'}" FontSize="12" Foreground="#A0A0A0"/>
                                                <TextBlock Text="•" Foreground="#606060"/>
                                                <TextBlock Text="{Binding ModificadoPor, StringFormat='Subido por: {0}'}" FontSize="12" Foreground="#00D2FF"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="2" Content="⋮" Background="Transparent" Foreground="White" FontSize="20" VerticalAlignment="Center" CornerRadius="15">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="📥 Descargar" Click="BtnDownload_Click"/>
                                                    <MenuItem Header="✏️ Renombrar" Click="BtnRename_Click"/>
                                                    <MenuItem Header="📦 Mover a..." Click="BtnMove_Click"/>
                                                    <MenuItem Header="🗑️ Eliminar" Click="BtnDelete_Click" Foreground="#FF5555"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- MODO CUADRÍCULA / GRID -->
                        <ListBox Name="LstFilesGrid" Background="Transparent" BorderThickness="0" Margin="10" DoubleTapped="LstFilesGrid_DoubleTapped" IsVisible="False">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="shared:ArchivoDTO">
                                    <Border Width="160" Height="175" Margin="6" Background="#16FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8" AttachedToVisualTree="FileRow_AttachedToVisualTree">
                                        <Grid RowDefinitions="*, Auto, Auto">
                                            <Border Grid.Row="0" CornerRadius="8" ClipToBounds="True" Background="#10FFFFFF" Margin="0,0,0,6">
                                                <Grid>
                                                    <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                    <TextBlock Text="{Binding Icono}" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Nombre}"/>
                                            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                                <TextBlock Grid.Column="0" Text="{Binding PesoBytes, Converter={StaticResource BytesToSizeConverter}}" FontSize="11" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="⋮" Background="Transparent" Foreground="White" FontSize="16" Padding="4,0" CornerRadius="10">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="📥 Descargar" Click="BtnDownload_Click"/>
                                                            <MenuItem Header="✏️ Renombrar" Click="BtnRename_Click"/>
                                                            <MenuItem Header="📦 Mover a..." Click="BtnMove_Click"/>
                                                            <MenuItem Header="🗑️ Eliminar" Click="BtnDelete_Click" Foreground="#FF5555"/>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- ZONA NOTAS / PORTAPAPELES EN LA NUBE (FEED TIPO CHAT CON BÚSQUEDA) -->
            <Border Name="NotesContainer" Grid.Row="1" Margin="20,10" Background="#10FFFFFF" CornerRadius="12" BorderBrush="#20FFFFFF" BorderThickness="1" IsVisible="False">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- BARRA DE BÚSQUEDA Y TOTAL EN NOTAS -->
                    <Grid Grid.Row="0" Margin="14,10,14,4" ColumnDefinitions="*, Auto">
                        <Border Grid.Column="0" Background="#18FFFFFF" CornerRadius="8" Padding="2" HorizontalAlignment="Stretch" MaxWidth="380">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#80FFFFFF" FontSize="13"/>
                                <TextBox Grid.Column="1" Name="TxtSearchNotes" PlaceholderText="Buscar en notas y enlaces..." Background="Transparent" BorderThickness="0" Foreground="White" Padding="6,6" TextChanged="TxtSearchNotes_TextChanged"/>
                                <Button Grid.Column="2" Name="BtnClearSearchNotes" Content="✕" Click="BtnClearSearchNotes_Click" Background="Transparent" Foreground="#A0A0A0" Padding="8,4" CornerRadius="6" IsVisible="False"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Name="TxtNotesCount" Text="0 notas" Foreground="#A0A0A0" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
                    </Grid>

                    <!-- FEED DE NOTAS -->
                    <ScrollViewer Grid.Row="1" Name="ScrollNotes" VerticalScrollBarVisibility="Auto" Margin="10">
                        <StackPanel Spacing="8">
                            <TextBlock Name="TxtNoNotes" Text="No hay notas o enlaces guardados aún. Escribe el primero abajo ✍️" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       Margin="0,80,0,0" FontSize="15" Foreground="#60FFFFFF" IsVisible="False"/>
                            <ItemsControl Name="LstNotes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="shared:NotaDTO">
                                        <Border Margin="0,4" Padding="14,12" Background="#18FFFFFF" CornerRadius="10" BorderBrush="#25FFFFFF" BorderThickness="1">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding CreadoPor}" Foreground="#00D2FF" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="•" Foreground="#50FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding FechaCreacion, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#80FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <SelectableTextBlock Text="{Binding Contenido}" TextWrapping="Wrap" Foreground="White" FontSize="14" LineHeight="20"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="12,0,0,0">
                                                    <Button Content="📋 Copiar" Click="BtnCopyNote_Click" 
                                                            Background="#30FFFFFF" Foreground="White" CornerRadius="6" FontSize="12" Padding="10,6"/>
                                                    <Button Content="🗑️" Click="BtnDeleteNote_Click" 
                                                            Background="Transparent" Foreground="#FF5555" CornerRadius="6" FontSize="12" Padding="8,6" 
                                                            ToolTip.Tip="Eliminar nota"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- BARRA INFERIOR DE ENTRADA -->
                    <Border Grid.Row="2" Background="#1AFFFFFF" BorderBrush="#25FFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Name="TxtNoteInput" 
                                     PlaceholderText="Escribe una nota, texto, enlace o recordatorio... (Enter para enviar, Shift+Enter para salto de línea)" 
                                     AcceptsReturn="True" 
                                     MaxHeight="120" 
                                     TextWrapping="Wrap" 
                                     Background="#15FFFFFF" 
                                     Foreground="White" 
                                     CornerRadius="8" 
                                     Padding="12,10"
                                     KeyDown="TxtNoteInput_KeyDown"/>
                            <Button Grid.Column="1" Name="BtnSendNote" Content="Guardar ↵" Click="BtnSendNote_Click" 
                                    Background="#00D2FF" Foreground="White" FontWeight="Bold" CornerRadius="8" 
                                    Padding="18,10" Margin="10,0,0,0" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- BOTÓN FLOTANTE (FAB) -->
            <Button Name="BtnUploadFab" Grid.Row="1" Classes="Fab" Content="+" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30" Click="BtnUploadManual_Click"/>

            <!-- PANEL DE TRANSFERENCIA MEJORADO CON VELOCIDAD Y CANCELACIÓN -->
            <Border Name="TransferPanel" Grid.Row="2" Margin="20,0,20,16" Padding="14,10" Background="#222238" BorderBrush="#4000D2FF" BorderThickness="1" CornerRadius="10" IsVisible="False">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Name="TxtTransferStatus" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            <Border Grid.Column="1" Background="#2500D2FF" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock Name="TxtTransferSpeed" Text="0 KB/s" Foreground="#00D2FF" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <ProgressBar Name="PrgTransfer" Minimum="0" Maximum="100" Height="6" CornerRadius="3" Foreground="#00D2FF" Background="#20FFFFFF"/>
                    </StackPanel>
                    <Button Grid.Column="1" Name="BtnCancelTransfer" Content="✕ Cancelar" Click="BtnCancelTransfer_Click" Background="#30FF5555" Foreground="#FF7777" FontWeight="Bold" FontSize="11" CornerRadius="6" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- PANTALLA DE LOGIN OVERLAY -->
        <Grid Name="LoginView" IsVisible="True" Background="#E60A0A0A">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,20">
                <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="16" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                    <StackPanel Spacing="18">
                        <TextBlock Text="☁️ Nube-Zero" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Inicia sesión para continuar" HorizontalAlignment="Center" Foreground="#A0A0A0" Margin="0,0,0,10"/>
                        <TextBlock Text="La URL y la huella verificada se guardan en este dispositivo. La contraseña no se guarda salvo que actives el llavero de macOS." FontSize="11" Foreground="#A0A0A0" TextWrapping="Wrap"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Name="TxtServerUrl" Text="https://192.168.1.94:8080" PlaceholderText="URL Servidor (ej. https://192.168.1.94:8080)" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                            <Button Grid.Column="1" Name="BtnDiscover" ToolTip.Tip="Buscar servidores en la red local" Content="🔍" Click="BtnDiscover_Click" Width="42" Margin="8,0,0,0" CornerRadius="8" Background="#30FFFFFF" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </Grid>
                        
                        <ComboBox Name="CmbDiscoveredServers" IsVisible="False" PlaceholderText="Servidores encontrados..." Background="#10FFFFFF" Foreground="White" CornerRadius="8" HorizontalAlignment="Stretch" SelectionChanged="CmbDiscoveredServers_SelectionChanged"/>
                        <TextBlock Name="TxtDiscoveryStatus" Foreground="#00D2FF" FontSize="11" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>

                        <TextBox Name="TxtServerFingerprint" PlaceholderText="Huella SHA-256 del certificado (verificar por SSH)" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                        <TextBox Name="TxtUser" PlaceholderText="Usuario" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                        <TextBox Name="TxtPassword" PlaceholderText="Contraseña" PasswordChar="•" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                        <CheckBox Name="ChkRememberPassword" Content="Recordar contraseña en el llavero de macOS" IsVisible="False" Foreground="White"/>
                        
                        <TextBlock Name="TxtLoginError" Foreground="#FF5555" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>
                        
                        <Button Name="BtnLogin" Content="Conectar" Click="BtnLogin_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10" Margin="0,10,0,0"/>
                        <Button Name="BtnCheckUpdates" Content="Buscar actualizaciones" Click="BtnCheckUpdates_Click" Background="#30FFFFFF" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="8"/>
                        <TextBlock Name="TxtUpdateStatus" Foreground="#00D2FF" FontSize="11" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- MODAL DE GESTIÓN DE USUARIOS (SÓLO ADMIN) -->
        <Grid Name="UsersAdminView" IsVisible="False" Background="#E60A0A0A">
            <Border Background="#222232" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Width="680" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <Grid RowDefinitions="Auto, *, Auto">
                    <TextBlock Grid.Row="0" Text="👥 Gestión de Usuarios (Admin)" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    
                    <Grid Grid.Row="1" ColumnDefinitions="*, 20, 260">
                        <!-- LISTA DE USUARIOS -->
                        <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="10" Padding="10">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="Usuarios Registrados" FontWeight="SemiBold" Foreground="#A0A0A0" Margin="5,0,0,10"/>
                                <ListBox Grid.Row="1" Name="LstUsersAdmin" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="shared:UserDTO">
                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="5,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Username}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#2500D2FF" CornerRadius="6" Padding="6,2" Margin="5,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Role}" FontSize="11" Foreground="#00D2FF" FontWeight="SemiBold"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="🗑️" Tag="{Binding Username}" Click="BtnDeleteUserAdmin_Click" Background="Transparent" Foreground="#FF5555" VerticalAlignment="Center" Padding="5,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- FORMULARIO CREAR USUARIO -->
                        <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="10" Padding="15">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Añadir Usuario" FontWeight="Bold" Foreground="White" FontSize="16"/>
                                <TextBox Name="TxtNewUser" PlaceholderText="Nombre de usuario" Background="#10FFFFFF" Foreground="White" CornerRadius="6" Padding="8"/>
                                <TextBox Name="TxtNewPassword" PlaceholderText="Contraseña" PasswordChar="•" Background="#10FFFFFF" Foreground="White" CornerRadius="6" Padding="8"/>
                                
                                <TextBlock Text="Nivel de Acceso (Rol):" Foreground="#A0A0A0" FontSize="12" Margin="0,5,0,0"/>
                                <ComboBox Name="CmbNewUserRole" SelectedIndex="0" HorizontalAlignment="Stretch" Background="#10FFFFFF" Foreground="White" CornerRadius="6">
                                    <ComboBoxItem Content="Estandar"/>
                                    <ComboBoxItem Content="Visitante"/>
                                    <ComboBoxItem Content="Admin"/>
                                </ComboBox>
                                
                                <TextBlock Name="TxtUserAdminError" Foreground="#FF5555" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
                                <Button Content="➕ Crear Usuario" Click="BtnConfirmAddUser_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6" Padding="8" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Grid.Row="2" Content="Cerrar" Click="BtnCloseUsersAdmin_Click" Background="#30FFFFFF" Foreground="White" HorizontalAlignment="Right" CornerRadius="8" Padding="15,8" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL DE CAMBIAR CONTRASEÑA (TODOS LOS USUARIOS) -->
        <Grid Name="ChangePasswordView" IsVisible="False" Background="#E60A0A0A">
            <Border Background="#222232" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <StackPanel Spacing="15">
                    <TextBlock Text="🔑 Cambiar Contraseña" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                    
                    <TextBox Name="TxtCurrentPassword" PlaceholderText="Contraseña actual" PasswordChar="•" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    <TextBox Name="TxtNewPasswordChange" PlaceholderText="Nueva contraseña" PasswordChar="•" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    <TextBox Name="TxtConfirmPasswordChange" PlaceholderText="Confirmar nueva contraseña" PasswordChar="•" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    
                    <TextBlock Name="TxtChangePasswordError" Foreground="#FF5555" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                        <Button Content="Cancelar" Click="BtnCloseChangePassword_Click" Background="#FF5555" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10" Width="145"/>
                        <Button Content="Guardar" Click="BtnConfirmChangePassword_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10" Width="145"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL DE NUEVA CARPETA -->
        <Grid Name="NewFolderModal" IsVisible="False" Background="#E60A0A0A">
            <Border Background="#222232" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <StackPanel Spacing="15">
                    <TextBlock Text="📁 Nueva Carpeta" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBox Name="TxtNewFolderName" PlaceholderText="Nombre de la carpeta" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    <TextBlock Name="TxtNewFolderError" Foreground="#FF5555" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                        <Button Content="Cancelar" Click="BtnCancelNewFolder_Click" Background="#FF5555" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10" Width="145"/>
                        <Button Content="Crear" Click="BtnConfirmNewFolder_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10" Width="145"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL DE RENOMBRAR -->
        <Grid Name="RenameModal" IsVisible="False" Background="#E60A0A0A">
            <Border Background="#222232" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <StackPanel Spacing="15">
                    <TextBlock Name="TxtRenameTitle" Text="✏️ Renombrar" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBox Name="TxtNewItemName" PlaceholderText="Nuevo nombre" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    <TextBlock Name="TxtRenameError" Foreground="#FF5555" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                        <Button Content="Cancelar" Click="BtnCancelRename_Click" Background="#FF5555" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10" Width="145"/>
                        <Button Content="Guardar" Click="BtnConfirmRename_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10" Width="145"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL DE MOVER ARCHIVO/CARPETA -->
        <Grid Name="MoveModal" IsVisible="False" Background="#E60A0A0A">
            <Border Background="#222232" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Width="420" MaxHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <Grid RowDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,12">
                        <TextBlock Name="TxtMoveTitle" Text="📦 Mover elemento" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Selecciona la carpeta destino:" Foreground="#A0A0A0" FontSize="12"/>
                    </StackPanel>
                    
                    <Border Grid.Row="1" Background="#15FFFFFF" CornerRadius="8" Padding="6" MinHeight="180">
                        <ListBox Name="LstMoveDestinations" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4">
                                        <TextBlock Text="📁" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
                        <TextBlock Name="TxtMoveError" Foreground="#FF5555" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Click="BtnCancelMove_Click" Background="#FF5555" Foreground="White" CornerRadius="8" Padding="14,8"/>
                            <Button Content="Mover Aquí" Click="BtnConfirmMove_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="16,8"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
