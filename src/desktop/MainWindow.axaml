<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:NubeZero.Shared;assembly=NubeZero.Shared"
        x:Class="NubeZero.Desktop.MainWindow"
        Title="NubeZero" Width="950" Height="650"
        Background="#121212"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        ExtendClientAreaToDecorationsHint="True"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Button.Fab">
            <Setter Property="Background" Value="#00D2FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Fab:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1)"/>
            <Setter Property="Background" Value="#3A7BD5"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- FONDO PRINCIPAL CON GRADIENTE SLEEK -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#1E1E2C"/>
                    <GradientStop Offset="1" Color="#121212"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- VISTA PRINCIPAL (Sólo visible si IsLoggedIn = True) -->
        <Grid Name="MainView" IsVisible="False" RowDefinitions="Auto, *, Auto">
            
            <!-- HEADER -->
            <Border Grid.Row="0" Margin="20,40,20,10" Background="#20FFFFFF" CornerRadius="12" Padding="15">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                        <TextBlock Text="☁️ Nube-Zero" FontSize="24" FontWeight="Black" Foreground="White" />
                        <TextBlock Name="TxtUserInfo" Text="" VerticalAlignment="Center" Foreground="#00D2FF" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Name="TxtStatus" Text="Conectado" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Content="🔄 Recargar" Click="BtnRefresh_Click" Background="#30FFFFFF" Foreground="White" CornerRadius="8"/>
                        <Button Name="BtnUsersAdmin" Content="👥 Usuarios" Click="BtnUsersAdmin_Click" Background="#30FFFFFF" Foreground="White" CornerRadius="8" IsVisible="False"/>
                        <Button Content="🔑 Contraseña" Click="BtnOpenChangePassword_Click" Background="#30FFFFFF" Foreground="White" CornerRadius="8"/>
                        <Button Content="Salir" Click="BtnLogout_Click" Background="#FF5555" Foreground="White" CornerRadius="8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ZONA DRAG & DROP Y LISTADO -->
            <Border Grid.Row="1" Margin="20,10" Background="#10FFFFFF" CornerRadius="12" BorderBrush="#20FFFFFF" BorderThickness="1">
                <Grid>
                    <TextBlock Name="TxtDragHint" Text="Arrastra tus archivos aquí" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="#40FFFFFF" FontWeight="Bold" IsVisible="True"/>
                    <ListBox Name="LstFiles" Background="Transparent" BorderThickness="0" Margin="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="shared:ArchivoDTO">
                                <Grid ColumnDefinitions="Auto, *, Auto" Margin="5">
                                    <TextBlock Grid.Column="0" Text="{Binding EsCarpeta, Converter={StaticResource BoolToIconConverter}}" FontSize="24" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="16" Foreground="White"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding PesoBytes, Converter={StaticResource BytesToSizeConverter}}" FontSize="12" Foreground="#A0A0A0"/>
                                            <TextBlock Text="•" Foreground="#606060"/>
                                            <TextBlock Text="{Binding FechaModificacion, StringFormat='dd/MM/yyyy HH:mm'}" FontSize="12" Foreground="#A0A0A0"/>
                                            <TextBlock Text="•" Foreground="#606060"/>
                                            <TextBlock Text="{Binding ModificadoPor, StringFormat='Subido por: {0}'}" FontSize="12" Foreground="#00D2FF"/>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <Button Grid.Column="2" Content="⋮" Background="Transparent" Foreground="White" FontSize="20" VerticalAlignment="Center" CornerRadius="15">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="📥 Descargar" Click="BtnDownload_Click"/>
                                                <MenuItem Header="🗑️ Eliminar" Click="BtnDelete_Click" Foreground="#FF5555"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- BOTÓN FLOTANTE (FAB) -->
            <Button Name="BtnUploadFab" Grid.Row="1" Classes="Fab" Content="+" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30" Click="BtnUploadManual_Click"/>
        </Grid>

        <!-- PANTALLA DE LOGIN OVERLAY -->
        <Grid Name="LoginView" IsVisible="True" Background="#E60A0A0A">
            <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="16" Width="350" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <StackPanel Spacing="20">
                    <TextBlock Text="☁️ Nube-Zero" FontSize="28" FontWeight="Black" HorizontalAlignment="Center" Foreground="White"/>
                    <TextBlock Text="Inicia sesión para continuar" HorizontalAlignment="Center" Foreground="#A0A0A0" Margin="0,0,0,10"/>
                    
                    <TextBox Name="TxtServerUrl" Text="http://192.168.1.94:8080" PlaceholderText="URL Servidor (ej. http://192.168.1.94:8080)" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    <TextBox Name="TxtUser" PlaceholderText="Usuario" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    <TextBox Name="TxtPassword" PlaceholderText="Contraseña" PasswordChar="•" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    
                    <TextBlock Name="TxtLoginError" Foreground="#FF5555" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>
                    
                    <Button Content="Conectar" Click="BtnLogin_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL DE GESTIÓN DE USUARIOS (SÓLO ADMIN) -->
        <Grid Name="UsersAdminView" IsVisible="False" Background="#E60A0A0A">
            <Border Background="#222232" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Width="680" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <Grid RowDefinitions="Auto, *, Auto">
                    <TextBlock Grid.Row="0" Text="👥 Gestión de Usuarios (Admin)" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    
                    <Grid Grid.Row="1" ColumnDefinitions="*, 20, 260">
                        <!-- LISTA DE USUARIOS -->
                        <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="10" Padding="10">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="Usuarios Registrados" FontWeight="SemiBold" Foreground="#A0A0A0" Margin="5,0,0,10"/>
                                <ListBox Grid.Row="1" Name="LstUsersAdmin" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="shared:UserDTO">
                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="5,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Username}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#2500D2FF" CornerRadius="6" Padding="6,2" Margin="5,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Role}" FontSize="11" Foreground="#00D2FF" FontWeight="SemiBold"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="🗑️" Tag="{Binding Username}" Click="BtnDeleteUserAdmin_Click" Background="Transparent" Foreground="#FF5555" VerticalAlignment="Center" Padding="5,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- FORMULARIO CREAR USUARIO -->
                        <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="10" Padding="15">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Añadir Usuario" FontWeight="Bold" Foreground="White" FontSize="16"/>
                                <TextBox Name="TxtNewUser" PlaceholderText="Nombre de usuario" Background="#10FFFFFF" Foreground="White" CornerRadius="6" Padding="8"/>
                                <TextBox Name="TxtNewPassword" PlaceholderText="Contraseña" PasswordChar="•" Background="#10FFFFFF" Foreground="White" CornerRadius="6" Padding="8"/>
                                
                                <TextBlock Text="Nivel de Acceso (Rol):" Foreground="#A0A0A0" FontSize="12" Margin="0,5,0,0"/>
                                <ComboBox Name="CmbNewUserRole" SelectedIndex="0" HorizontalAlignment="Stretch" Background="#10FFFFFF" Foreground="White" CornerRadius="6">
                                    <ComboBoxItem Content="Estandar"/>
                                    <ComboBoxItem Content="Visitante"/>
                                    <ComboBoxItem Content="Admin"/>
                                </ComboBox>
                                
                                <TextBlock Name="TxtUserAdminError" Foreground="#FF5555" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
                                <Button Content="➕ Crear Usuario" Click="BtnConfirmAddUser_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="6" Padding="8" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Grid.Row="2" Content="Cerrar" Click="BtnCloseUsersAdmin_Click" Background="#30FFFFFF" Foreground="White" HorizontalAlignment="Right" CornerRadius="8" Padding="15,8" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL DE CAMBIAR CONTRASEÑA (TODOS LOS USUARIOS) -->
        <Grid Name="ChangePasswordView" IsVisible="False" Background="#E60A0A0A">
            <Border Background="#222232" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <StackPanel Spacing="15">
                    <TextBlock Text="🔑 Cambiar Contraseña" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                    
                    <TextBox Name="TxtCurrentPassword" PlaceholderText="Contraseña actual" PasswordChar="•" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    <TextBox Name="TxtNewPasswordChange" PlaceholderText="Nueva contraseña" PasswordChar="•" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    <TextBox Name="TxtConfirmPasswordChange" PlaceholderText="Confirmar nueva contraseña" PasswordChar="•" Background="#10FFFFFF" Foreground="White" CornerRadius="8" Padding="10"/>
                    
                    <TextBlock Name="TxtChangePasswordError" Foreground="#FF5555" HorizontalAlignment="Center" IsVisible="False" TextWrapping="Wrap"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch" Margin="0,10,0,0">
                        <Button Content="Cancelar" Click="BtnCloseChangePassword_Click" Background="#FF5555" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10" Width="145"/>
                        <Button Content="Guardar" Click="BtnConfirmChangePassword_Click" Background="#00D2FF" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="8" Padding="10" Width="145"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
