<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:NubeZero.Shared;assembly=NubeZero.Shared"
             x:Class="NubeZero.Mobile.MainPage"
             BackgroundColor="#121212">

    <Grid>
        <!-- FONDO -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E1E2C" Offset="0.0" />
                    <GradientStop Color="#121212" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- VISTA PRINCIPAL (Archivos) -->
        <Grid x:Name="MainView" IsVisible="False" RowDefinitions="Auto, *">
            <!-- HEADER -->
            <Frame Grid.Row="0" Margin="15,40,15,10" BackgroundColor="#20FFFFFF" CornerRadius="12" BorderColor="Transparent" Padding="15">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="☁️ Nube-Zero" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="TxtStatus" Text="Conectado" TextColor="#A0A0A0" FontSize="12"/>
                    </VerticalStackLayout>
                    <ImageButton Grid.Column="1" Source="dotnet_bot.png" Clicked="BtnRefresh_Clicked" BackgroundColor="#30FFFFFF" CornerRadius="8" WidthRequest="40" HeightRequest="40" Padding="8"/>
                </Grid>
            </Frame>

            <!-- LISTA DE ARCHIVOS -->
            <RefreshView Grid.Row="1" x:Name="RefreshView" Refreshing="RefreshView_Refreshing">
                <CollectionView x:Name="LstFiles" Margin="15,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="shared:ArchivoDTO">
                            <Frame Margin="0,5" Padding="10" BackgroundColor="#10FFFFFF" BorderColor="#20FFFFFF" CornerRadius="10">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Label Grid.Column="0" Text="{Binding EsCarpeta, Converter={StaticResource BoolToIconConverter}}" FontSize="24" VerticalOptions="Center" Margin="0,0,15,0"/>
                                    
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                                        <HorizontalStackLayout Spacing="5" Margin="0,2,0,0">
                                            <Label Text="{Binding PesoBytes, Converter={StaticResource BytesToSizeConverter}}" FontSize="12" TextColor="#A0A0A0"/>
                                            <Label Text="•" TextColor="#606060"/>
                                            <Label Text="{Binding ModificadoPor, StringFormat='Por {0}'}" FontSize="12" TextColor="#00D2FF"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    
                                    <!-- Menú contextual (3 puntos) -->
                                    <ImageButton Grid.Column="2" Source="dotnet_bot.png" BackgroundColor="Transparent" WidthRequest="30" HeightRequest="30" VerticalOptions="Center" Clicked="BtnItemMenu_Clicked" CommandParameter="{Binding .}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- FAB (Botón flotante) -->
            <Button Grid.Row="1" Text="+" BackgroundColor="#00D2FF" TextColor="White" FontSize="28" FontAttributes="Bold"
                    WidthRequest="60" HeightRequest="60" CornerRadius="30"
                    HorizontalOptions="End" VerticalOptions="End" Margin="20,20,20,30"
                    Shadow="{Shadow Brush=Black, Offset='0,4', Radius=10, Opacity=0.4}"
                    Clicked="BtnUpload_Clicked"/>
        </Grid>

        <!-- VISTA DE LOGIN -->
        <Grid x:Name="LoginView" IsVisible="True" BackgroundColor="#E60A0A0A">
            <Frame BackgroundColor="#20FFFFFF" BorderColor="#30FFFFFF" CornerRadius="16" Margin="30" Padding="30" VerticalOptions="Center">
                <VerticalStackLayout Spacing="20">
                    <Label Text="☁️ Nube-Zero" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>
                    <Label Text="Inicia sesión en tu Pi Zero" HorizontalOptions="Center" TextColor="#A0A0A0" Margin="0,0,0,10"/>
                    
                    <Entry x:Name="TxtServerIp" Placeholder="IP del Servidor (Ej: 192.168.1.100)" Text="192.168.1.100" BackgroundColor="#10FFFFFF" TextColor="White" PlaceholderColor="#80FFFFFF" />
                    <Entry x:Name="TxtUser" Placeholder="Usuario" BackgroundColor="#10FFFFFF" TextColor="White" PlaceholderColor="#80FFFFFF" />
                    <Entry x:Name="TxtPassword" Placeholder="Contraseña" IsPassword="True" BackgroundColor="#10FFFFFF" TextColor="White" PlaceholderColor="#80FFFFFF" />
                    
                    <Label x:Name="TxtLoginError" TextColor="#FF5555" HorizontalOptions="Center" IsVisible="False"/>
                    
                    <Button Text="Conectar" Clicked="BtnLogin_Clicked" BackgroundColor="#00D2FF" TextColor="White" FontAttributes="Bold" CornerRadius="8" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
