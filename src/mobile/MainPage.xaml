<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:NubeZero.Shared;assembly=NubeZero.Shared"
             x:Class="NubeZero.Mobile.MainPage"
             BackgroundColor="#121212">

    <Grid>
        <!-- FONDO -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E1E2C" Offset="0.0" />
                    <GradientStop Color="#121212" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- VISTA PRINCIPAL (Archivos / Notas) -->
        <Grid x:Name="MainView" IsVisible="False" RowDefinitions="Auto, Auto, *, Auto">
            <!-- HEADER -->
            <Frame Grid.Row="0" Margin="15,40,15,10" BackgroundColor="#20FFFFFF" CornerRadius="12" BorderColor="Transparent" Padding="15">
                <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="☁️ Nube-Zero" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="TxtUserInfo" Text="" TextColor="#00D2FF" FontSize="11" FontAttributes="Bold"/>
                        <Label x:Name="TxtStatus" Text="Conectado" TextColor="#A0A0A0" FontSize="11"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="🔄" Clicked="BtnRefresh_Clicked" BackgroundColor="#30FFFFFF" TextColor="White" CornerRadius="8" HeightRequest="38" WidthRequest="38" Margin="0,0,5,0" Padding="0"/>
                    <Button Grid.Column="2" x:Name="BtnUsersAdmin" Text="👥" Clicked="BtnUsersAdmin_Clicked" BackgroundColor="#30FFFFFF" TextColor="White" CornerRadius="8" HeightRequest="38" WidthRequest="38" Margin="0,0,5,0" Padding="0" IsVisible="False"/>
                    <Button Grid.Column="3" Text="🔑" Clicked="BtnChangePassword_Clicked" BackgroundColor="#30FFFFFF" TextColor="White" CornerRadius="8" HeightRequest="38" WidthRequest="38" Margin="0,0,5,0" Padding="0"/>
                    <Button Grid.Column="4" Text="Salir" Clicked="BtnLogout_Clicked" BackgroundColor="#FF5555" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="10,0"/>
                    <Button Grid.Column="5" Text="⬇" Clicked="BtnCheckUpdates_Clicked" BackgroundColor="#30FFFFFF" TextColor="White" CornerRadius="8" HeightRequest="38" WidthRequest="38" Margin="5,0,0,0" Padding="0" SemanticProperties.Description="Buscar actualizaciones"/>
                </Grid>
            </Frame>

            <!-- SELECTOR DE PESTAÑAS (ARCHIVOS / NOTAS) -->
            <Frame Grid.Row="1" Margin="15,0,15,10" BackgroundColor="#18FFFFFF" CornerRadius="8" Padding="2" BorderColor="Transparent">
                <Grid ColumnDefinitions="*, *">
                    <Button Grid.Column="0" x:Name="BtnTabFiles" Text="📁 Archivos" Clicked="BtnTabFiles_Clicked" BackgroundColor="#00D2FF" TextColor="White" FontAttributes="Bold" CornerRadius="6" HeightRequest="36" Padding="0"/>
                    <Button Grid.Column="1" x:Name="BtnTabNotes" Text="💬 Notas" Clicked="BtnTabNotes_Clicked" BackgroundColor="Transparent" TextColor="#A0A0A0" FontAttributes="Bold" CornerRadius="6" HeightRequest="36" Padding="0"/>
                </Grid>
            </Frame>

            <!-- ZONA ARCHIVOS -->
            <Grid x:Name="FilesContainer" Grid.Row="2" RowDefinitions="Auto, *" IsVisible="True">
                <Grid Grid.Row="0" Margin="15,0,15,8" ColumnDefinitions="Auto, *">
                    <Button x:Name="BtnParentFolder" Text="↑" Clicked="BtnParentFolder_Clicked" IsVisible="False" BackgroundColor="#30FFFFFF" TextColor="White" WidthRequest="38" HeightRequest="36" Padding="0"/>
                    <Label x:Name="TxtCurrentPath" Grid.Column="1" Text="/" TextColor="#00D2FF" VerticalTextAlignment="Center" Margin="8,0"/>
                </Grid>

                <!-- LISTA DE ARCHIVOS -->
                <RefreshView Grid.Row="1" x:Name="RefreshView" Refreshing="RefreshView_Refreshing">
                    <CollectionView x:Name="LstFiles" Margin="15,0" SelectionMode="Single" SelectionChanged="LstFiles_SelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="shared:ArchivoDTO">
                                <Frame Margin="0,5" Padding="10" BackgroundColor="#10FFFFFF" BorderColor="#20FFFFFF" CornerRadius="10" Loaded="FileItem_Loaded" BindingContextChanged="FileItem_Loaded">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Grid Grid.Column="0" WidthRequest="48" HeightRequest="48" Margin="0,0,12,0">
                                            <Image Source="{Binding ThumbnailSource}" Aspect="AspectFill"/>
                                            <Label Text="{Binding Icono}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                        
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" TextColor="White"/>
                                            <HorizontalStackLayout Spacing="5" Margin="0,2,0,0">
                                                <Label Text="{Binding PesoBytes, Converter={StaticResource BytesToSizeConverter}}" FontSize="12" TextColor="#A0A0A0"/>
                                                <Label Text="•" TextColor="#606060"/>
                                                <Label Text="{Binding ModificadoPor, StringFormat='Por {0}'}" FontSize="12" TextColor="#00D2FF"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        
                                        <!-- Menú contextual (3 puntos) -->
                                        <Button Grid.Column="2" Text="⋮" FontSize="24" BackgroundColor="Transparent" TextColor="White" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" Clicked="BtnItemMenu_Clicked" CommandParameter="{Binding .}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <!-- FAB (Botón flotante) -->
                <Button x:Name="BtnUploadFab" Grid.Row="1" Text="+" BackgroundColor="#00D2FF" TextColor="White" FontSize="28" FontAttributes="Bold"
                        WidthRequest="60" HeightRequest="60" CornerRadius="30"
                        HorizontalOptions="End" VerticalOptions="End" Margin="20,20,20,30"
                        Shadow="{Shadow Brush=Black, Offset='0,4', Radius=10, Opacity=0.4}"
                        Clicked="BtnUpload_Clicked"/>
            </Grid>

            <!-- ZONA NOTAS (FEED TIPO CHAT) -->
            <Grid x:Name="NotesContainer" Grid.Row="2" RowDefinitions="*, Auto" IsVisible="False">
                <RefreshView x:Name="NotesRefreshView" Refreshing="NotesRefreshView_Refreshing">
                    <CollectionView x:Name="LstNotes" Margin="15,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="shared:NotaDTO">
                                <Frame Margin="0,5" Padding="12" BackgroundColor="#18FFFFFF" BorderColor="#25FFFFFF" CornerRadius="10">
                                    <Grid RowDefinitions="Auto, Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding CreadoPor}" TextColor="#00D2FF" FontAttributes="Bold" FontSize="12"/>
                                                <Label Text="•" TextColor="#50FFFFFF" FontSize="10" VerticalOptions="Center"/>
                                                <Label Text="{Binding FechaCreacion, StringFormat='dd/MM/yyyy HH:mm'}" TextColor="#80FFFFFF" FontSize="10" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                                <Button Text="📋" FontSize="14" Clicked="BtnCopyNote_Clicked" CommandParameter="{Binding .}" BackgroundColor="#20FFFFFF" TextColor="White" WidthRequest="34" HeightRequest="32" CornerRadius="6" Padding="0"/>
                                                <Button Text="🗑️" FontSize="14" Clicked="BtnDeleteNote_Clicked" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="#FF5555" WidthRequest="34" HeightRequest="32" CornerRadius="6" Padding="0"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <Label Grid.Row="1" Text="{Binding Contenido}" TextColor="White" FontSize="14" LineBreakMode="WordWrap" Margin="0,6,0,0"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <!-- BARRA INFERIOR DE ENTRADA -->
                <Border Grid.Row="1" Margin="15,4,15,10" Padding="8,4" Stroke="#25FFFFFF" StrokeThickness="1" BackgroundColor="#20FFFFFF" StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Editor x:Name="TxtNoteInput" Placeholder="Escribe una nota o enlace..." AutoSize="TextChanges" MaximumHeightRequest="100" TextColor="White" PlaceholderColor="#80FFFFFF" BackgroundColor="Transparent" Margin="4,0"/>
                        <Button Grid.Column="1" x:Name="BtnSendNote" Text="Enviar" Clicked="BtnSendNote_Clicked" BackgroundColor="#00D2FF" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="12,0" VerticalOptions="End" Margin="4,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="TransferPanel" Grid.Row="3" Margin="15,0,15,12" Padding="10,6" Stroke="#20FFFFFF" StrokeThickness="1" BackgroundColor="#18FFFFFF" IsVisible="False">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="TxtTransferStatus" TextColor="White" FontSize="12"/>
                    <ProgressBar x:Name="PrgTransfer" Progress="0" HeightRequest="6"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- VISTA DE LOGIN -->
        <Grid x:Name="LoginView" IsVisible="True" BackgroundColor="#E60A0A0A">
            <Frame BackgroundColor="#20FFFFFF" BorderColor="#30FFFFFF" CornerRadius="16" Margin="30" Padding="30" VerticalOptions="Center">
                <VerticalStackLayout Spacing="20">
                    <Label Text="☁️ Nube-Zero" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>
                    <Label Text="Inicia sesión en tu Pi Zero" HorizontalOptions="Center" TextColor="#A0A0A0" Margin="0,0,0,10"/>
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry Grid.Column="0" x:Name="TxtServerIp" Placeholder="IP del Servidor (Ej: 192.168.1.100)" Text="192.168.1.100" BackgroundColor="#10FFFFFF" TextColor="White" PlaceholderColor="#80FFFFFF" ReturnType="Next" Completed="TxtServerIp_Completed" />
                        <Button Grid.Column="1" x:Name="BtnDiscoverMobile" Text="🔍" Clicked="BtnDiscoverMobile_Clicked" BackgroundColor="#30FFFFFF" TextColor="White" WidthRequest="44" HeightRequest="44" CornerRadius="8" Margin="8,0,0,0" Padding="0" />
                    </Grid>
                    
                    <Picker x:Name="PkrDiscoveredServers" IsVisible="False" Title="Selecciona un servidor" TextColor="White" TitleColor="#A0A0A0" BackgroundColor="#10FFFFFF" SelectedIndexChanged="PkrDiscoveredServers_SelectedIndexChanged"/>
                    <Label x:Name="TxtDiscoveryStatus" TextColor="#00D2FF" FontSize="11" HorizontalOptions="Center" IsVisible="False"/>

                    <Entry x:Name="TxtUser" Placeholder="Usuario" BackgroundColor="#10FFFFFF" TextColor="White" PlaceholderColor="#80FFFFFF" ReturnType="Next" Completed="TxtUser_Completed" />
                    <Entry x:Name="TxtPassword" Placeholder="Contraseña" IsPassword="True" BackgroundColor="#10FFFFFF" TextColor="White" PlaceholderColor="#80FFFFFF" ReturnType="Done" Completed="BtnLogin_Clicked" />
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <CheckBox x:Name="ChkRememberPassword" Color="#00D2FF" />
                        <Label Text="Recordar contraseña" TextColor="White" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    
                    <Label x:Name="TxtLoginError" TextColor="#FF5555" HorizontalOptions="Center" IsVisible="False"/>
                    
                    <Button Text="Conectar" Clicked="BtnLogin_Clicked" BackgroundColor="#00D2FF" TextColor="White" FontAttributes="Bold" CornerRadius="8" Margin="0,10,0,0"/>
                    <Button x:Name="BtnCheckUpdates" Text="Buscar actualizaciones" Clicked="BtnCheckUpdates_Clicked" BackgroundColor="#30FFFFFF" TextColor="White" CornerRadius="8"/>
                    <Label x:Name="TxtUpdateStatus" TextColor="#00D2FF" FontSize="11" HorizontalOptions="Center" IsVisible="False"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>

</ContentPage>
