<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VersionFileContent>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Version.cs'))</VersionFileContent>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(VersionFileContent), '(?&lt;= "V?)[0-9\.]+').Value)</Version>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
